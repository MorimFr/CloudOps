{
  "name": "@cloudops/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @cloudops/contracts",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run build --workspace @cloudops/contracts",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "npm run build --workspace @cloudops/contracts",
    "typecheck": "tsc --noEmit --pretty false",
    "prelint": "npm run build --workspace @cloudops/contracts",
    "lint": "tsc --noEmit --pretty false",
    "pretest": "npm run build --workspace @cloudops/contracts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloudops/contracts": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
